{
  "_comment": "Lokta Mermaid theme. Pass to mermaid.initialize() on the web, or to mermaid-cli (mmdc -c lokta-mermaid.json) to pre-render SVGs for Typst/print. Pair with the .mermaid CSS rules in lokta.marp.css / the docs site for hard edges + mono edge labels.",
  "startOnLoad": true,
  "securityLevel": "loose",
  "theme": "base",
  "themeVariables": {
    "fontFamily": "\"Archivo\", sans-serif",
    "fontSize": "14px",
    "background": "#F4F1DF",
    "primaryColor": "#FAF8EA",
    "primaryTextColor": "#1F1C13",
    "primaryBorderColor": "#2A2620",
    "lineColor": "#2A2620",
    "secondaryColor": "#EAE6D2",
    "tertiaryColor": "#EAE6D2",
    "tertiaryBorderColor": "#2A2620",
    "noteBkgColor": "#FBBC0E",
    "noteTextColor": "#1F1C13",
    "noteBorderColor": "#1F1C13",
    "actorBkg": "#FAF8EA",
    "actorBorder": "#2A2620",
    "actorTextColor": "#1F1C13",
    "actorLineColor": "#8E867A",
    "signalColor": "#2A2620",
    "signalTextColor": "#1F1C13",
    "labelBoxBkgColor": "#FBBC0E",
    "labelBoxBorderColor": "#1F1C13",
    "labelTextColor": "#1F1C13",
    "loopTextColor": "#1F1C13",
    "clusterBkg": "#EAE6D2",
    "clusterBorder": "#2A2620",
    "edgeLabelBackground": "#F4F1DF",
    "transitionColor": "#2A2620",
    "transitionLabelColor": "#1F1C13"
  },
  "flowchart": { "curve": "linear", "htmlLabels": true, "padding": 16, "nodeSpacing": 44, "rankSpacing": 56 },
  "sequence": { "mirrorActors": false, "actorMargin": 64, "messageFontFamily": "\"Spline Sans Mono\", monospace", "noteFontFamily": "\"Spline Sans Mono\", monospace" },
  "_classDefs": {
    "_comment": "Reusable node classes, add to any flowchart with `classDef`.",
    "hero": "fill:#FBBC0E,stroke:#1F1C13,stroke-width:1.5px,color:#1F1C13",
    "store": "fill:#6E8B6F,stroke:#1F1C13,stroke-width:1.5px,color:#FAF8EA",
    "dec": "fill:#2E3E5C,stroke:#1F1C13,stroke-width:1.5px,color:#FAF8EA",
    "danger": "fill:#C23A26,stroke:#1F1C13,stroke-width:1.5px,color:#FAF8EA",
    "muted": "fill:#EAE6D2,stroke:#2A2620,stroke-width:1.5px,color:#2A2620"
  }
}
