{
  "name": "lokta",
  "version": "0.1.0",
  "private": true,
  "description": "Lokta. An editorial UI design system, after the page layout of the cookbook Cuisine on Screen.",
  "license": "MIT",
  "workspaces": [
    "packages/tokens",
    "packages/css",
    "packages/marp-theme",
    "packages/typst",
    "packages/mermaid"
  ],
  "scripts": {
    "split:tokens": "node tokens/split.mjs",
    "verify": "node scripts/verify.mjs",
    "test": "node scripts/verify.mjs",
    "build:tokens": "node tokens/style-dictionary.config.mjs && node scripts/verify-tokens.mjs",
    "build:figma": "node scripts/build-figma.mjs",
    "build:css": "npm run build --workspace @lokta/css",
    "build:deck": "npm run build --workspace @lokta/marp-theme",
    "build:typst": "node scripts/build-typst.mjs",
    "build:site": "node scripts/build-site.mjs",
    "build": "npm run build:tokens && npm run build:figma && npm run build:css && npm run build:typst && npm run build:site",
    "fonts": "node scripts/fetch-fonts.mjs",
    "fonts:typst": "node scripts/fetch-typst-fonts.mjs",
    "install:typst": "node scripts/install-typst-local.mjs"
  },
  "devDependencies": {
    "@marp-team/marp-cli": "^4.1.2",
    "@tokens-studio/sd-transforms": "^1.2.13",
    "style-dictionary": "^4.4.0"
  },
  "engines": {
    "node": ">=20"
  }
}
